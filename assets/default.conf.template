# Grunt -> Vite migration, Phase 3: the previous version of this file was
# dead code -- the Dockerfile never copied it in, so the image ran the
# stock nginx config with no /ispyb proxy at all. Now wired in for real.
#
# ISPYB_UPSTREAM must point at wherever ISPyB is reachable from this
# container (a Docker Compose service name, an internal hostname -- there
# was no single answer available in this repo, since the orchestration
# layer that runs this image lives outside it). Override at container
# start: `docker run -e ISPYB_UPSTREAM=http://ispyb-host:8080 ...`.
# Substituted by the official nginx image's built-in envsubst-on-templates
# entrypoint step (nginx vars below stay literal $uri/$host/etc. -- only
# ${CURLY_BRACE} names matching an actual env var get replaced).
server {
    listen       80;
    server_name  localhost;
    root         /usr/share/nginx/html;

    location ~* \.(?:manifest|appcache|html?|xml|json)$ {
        expires -1;
    }

    location ~* \.(?:css|js)$ {
        try_files $uri =404;
        expires 1y;
        access_log off;
        add_header Cache-Control "public";
    }

    # Proxy ISPyB REST so every request from the browser is same-origin --
    # no CORS needed, the same principle the Vite dev-server proxy uses
    # locally (see vite.config.js).
    location /ispyb/ {
        proxy_pass ${ISPYB_UPSTREAM}/ispyb/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Any route containing a file extension (e.g. /node_modules/jquery/dist/jquery.js)
    location ~ ^.+\..+$ {
        try_files $uri =404;
    }

    # Any route that doesn't have a file extension (hash-based app routes)
    location / {
        try_files $uri $uri/ /index.html;
    }
}
